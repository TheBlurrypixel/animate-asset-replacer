{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animate Asset Replacement Recipe",
  "type": "object",
  "required": [
    "task",
    "output"
  ],
  "properties": {
    "task": {
      "enum": [
        "replace_embedded_manifest_image",
        "replace_embedded_manifest_images",
        "replace_embedded_manifest_assets"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "additionalProperties": true
    },
    "image_processing": {
      "type": "object",
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": true
    },
    "rules": {
      "type": "object",
      "additionalProperties": true
    },
    "conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "replacement_image": {
            "type": "string"
          },
          "image_processing": {
            "type": "object",
            "additionalProperties": true
          },
          "operation": {
            "type": "object",
            "additionalProperties": true
          },
          "verification": {
            "type": "object",
            "additionalProperties": true
          },
          "conditions": {
            "type": "object",
            "additionalProperties": true
          },
          "asset_type": {
            "enum": [
              "image",
              "audio"
            ]
          },
          "replacement_audio": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "output": {
      "type": "object",
      "required": [
        "type",
        "filename_suffix"
      ],
      "properties": {
        "type": {
          "const": "html"
        },
        "filename_suffix": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "replacements"
          ]
        },
        {
          "required": [
            "input",
            "target"
          ]
        }
      ]
    }
  ],
  "additionalProperties": true
}
