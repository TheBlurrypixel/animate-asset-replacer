{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animate Asset Replacement Recipe",
  "type": "object",
  "required": [
    "task",
    "target",
    "image_processing",
    "operation",
    "verification",
    "rules",
    "output"
  ],
  "properties": {
    "task": {
      "const": "replace_embedded_manifest_image"
    },
    "input": {
      "type": "object"
    },
    "target": {
      "type": "object",
      "required": [
        "object",
        "asset_id",
        "property"
      ],
      "properties": {
        "object": {
          "const": "lib.properties.manifest"
        },
        "asset_id": {
          "type": "string"
        },
        "property": {
          "const": "dataURI"
        }
      },
      "additionalProperties": true
    },
    "image_processing": {
      "type": "object",
      "properties": {
        "match_original_image_dimensions": {
          "type": "boolean"
        },
        "resize_mode": {
          "enum": [
            "stretch",
            "contain",
            "cover"
          ]
        },
        "preserve_aspect_ratio": {
          "type": "boolean"
        },
        "skip_resize_if_dimensions_already_match": {
          "type": "boolean"
        },
        "allow_cropping": {
          "type": "boolean"
        },
        "allow_padding": {
          "type": "boolean"
        },
        "target_width": {
          "type": [
            "string",
            "integer"
          ]
        },
        "target_height": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "properties": {
        "extract_original_image_dimensions": {
          "type": "boolean"
        },
        "resize_replacement_before_encoding": {
          "type": "boolean"
        },
        "data_uri_source": {
          "type": "string"
        },
        "convert_replacement_image_to_data_uri": {
          "type": "boolean"
        },
        "mime_type": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "preserve_replacement_format": {
          "type": "boolean"
        },
        "jpeg_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "replace_target_image_data": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "conditions": {
      "type": "object",
      "properties": {
        "asset_id_equals": {
          "type": "string"
        },
        "replacement_width_greater_than": {
          "type": "number"
        },
        "replacement_width_at_least": {
          "type": "number"
        },
        "replacement_format_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "original_width_equals": {
          "type": "number"
        },
        "original_height_equals": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object"
    },
    "rules": {
      "type": "object"
    },
    "output": {
      "type": "object",
      "required": [
        "type",
        "filename_suffix"
      ],
      "properties": {
        "type": {
          "const": "html"
        },
        "filename_suffix": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}