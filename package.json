{
  "name": "animate-asset-replacer",
  "version": "3.7.21",
  "description": "JSON + JavaScript driven Adobe Animate embedded image/audio asset replacer",
  "main": "src/main.js",
  "type": "commonjs",
  "bin": {
    "animate-replacer": "./src/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "dist:cli:win": "node scripts/build-cli-win.js",
    "dist:gui:win": "electron-builder --win --x64 --publish never --config.directories.output=release/windows-x64",
    "dist:win": "npm run dist:cli:win && npm run dist:gui:win",
    "dist:cli:mac:native": "node scripts/build-cli-mac.js",
    "dist:gui:mac:native": "node scripts/build-gui-mac.js",
    "dist:package:mac:native": "node scripts/package-mac-release.js",
    "dist:mac:native": "npm run dist:cli:mac:native && npm run dist:gui:mac:native && npm run dist:package:mac:native"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "@yao-pkg/pkg": "^6.22.0",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.local.animateassetreplacer",
    "productName": "Animate Asset Replacer",
    "files": [
      "src/**/*",
      "recipes/**/*",
      "schemas/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraFiles": [
      {
        "from": "release-cli/${os}-${arch}",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "pkg": {
    "assets": [
      "schemas/**/*"
    ]
  }
}
